# Port on which the backend server will run
PORT=5001

# PostgreSQL Database Connection URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zenta?schema=public"

# Secret key for signing JSON Web Tokens (JWT)
JWT_SECRET="your_jwt_secret_here_choose_a_long_random_string"

# Frontend URL (for CORS setup)
CLIENT_URL="http://localhost:3000"

# Gemini API Key (required for nutrition insights and meal balancer features)
# Get one from: https://aistudio.google.com/
GEMINI_API_KEY="your_gemini_api_key_here"

# Node Environment
NODE_ENV="development"
